+template <bool IsBf16>
+__global__ __launch_bounds__(64) void quant_mxfp4_even_group_kernel(
+    const void* __restrict__ input,
+    uint8_t* __restrict__ packed_output,
+    uint8_t* __restrict__ scale_output,
+    int64_t rows,
+    int64_t cols) {
+    constexpr int group_size = 32;
+
+    const int64_t row = static_cast<int64_t>(blockIdx.x);
+    const int group = static_cast<int>(blockIdx.y);
+    if (row >= rows) {
+        return;
+    }
+
+    __shared__ float abs_values[group_size];
+
+    const int tid = static_cast<int>(threadIdx.x);
+    const int groups = static_cast<int>(cols / group_size);
+    const int col_base = group * group_size;
+    const int64_t row_offset = row * cols;
+
+    if (tid < group_size) {
+        abs_values[tid] = fabsf(load_value<IsBf16>(input, row_offset + col_base + tid));
+    }
+
+    __syncthreads();
+
+    if (tid < 16) {
+        abs_values[tid] = fmaxf(abs_values[tid], abs_values[tid + 16]);
+    }
+    __syncthreads();
+    if (tid < 8) {
+        abs_values[tid] = fmaxf(abs_values[tid], abs_values[tid + 8]);
+    }
+    __syncthreads();
+    if (tid < 4) {
+        abs_values[tid] = fmaxf(abs_values[tid], abs_values[tid + 4]);
+    }
+    __syncthreads();
+    if (tid < 2) {
+        abs_values[tid] = fmaxf(abs_values[tid], abs_values[tid + 2]);
+    }
+    __syncthreads();
+    if (tid == 0) {
+        abs_values[0] = fmaxf(abs_values[0], abs_values[1]);
+        const int exponent = compute_exponent(abs_values[0]);
+        scale_output[row * static_cast<int64_t>(groups) + group] =
+            static_cast<uint8_t>(exponent + 127);
+        abs_values[0] = pow2_int(-exponent);
+    }
+    __syncthreads();
+
+    if (tid < 16) {
+        const float inv_scale = abs_values[0];
+        const int col0 = col_base + tid * 2;
+        const int col1 = col0 + 1;
+        const int64_t idx0 = row_offset + col0;
+        const int64_t idx1 = row_offset + col1;
+        const float mag0 = fabsf(load_value<IsBf16>(input, idx0)) * inv_scale;
+        const float mag1 = fabsf(load_value<IsBf16>(input, idx1)) * inv_scale;
+        const uint8_t q0 = quantize_mxfp4_even(mag0, load_sign_bit(input, idx0));
+        const uint8_t q1 = quantize_mxfp4_even(mag1, load_sign_bit(input, idx1));
+
+        packed_output[row * (cols / 2) + group * 16 + tid] =
+            static_cast<uint8_t>(q0 | static_cast<uint8_t>(q1 << 4));
+    }
+}
