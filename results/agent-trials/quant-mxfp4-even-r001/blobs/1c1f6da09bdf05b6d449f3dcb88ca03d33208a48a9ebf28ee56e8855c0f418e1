#include <hip/hip_runtime.h>
#include <hip/hip_fp16.h>
#include <stdint.h>

namespace {

__device__ __forceinline__ float bits_to_float(uint32_t bits) {
    union {
        uint32_t u;
        float f;
    } v;
    v.u = bits;
    return v.f;
}

__device__ __forceinline__ uint32_t float_to_bits(float value) {
    union {
        float f;
        uint32_t u;
    } v;
    v.f = value;
    return v.u;
}

template <bool IsBf16>
__device__ __forceinline__ float load_value(const void* input, int64_t index) {
    if constexpr (!IsBf16) {
        return __half2float(reinterpret_cast<const __half*>(input)[index]);
    } else {
    const uint16_t raw = reinterpret_cast<const uint16_t*>(input)[index];
    return bits_to_float(static_cast<uint32_t>(raw) << 16);
    }
}

__device__ __forceinline__ uint8_t load_sign_bit(const void* input, int64_t index) {
    const uint16_t raw = reinterpret_cast<const uint16_t*>(input)[index];
    return static_cast<uint8_t>((raw >> 12) & 0x8);
}

__device__ __forceinline__ int compute_exponent(float amax) {
    const uint32_t r_bits = (float_to_bits(amax) + 0x00200000u) & 0x7F800000u;
    if (r_bits == 0) {
        return -127;
    }

    int exponent = static_cast<int>(r_bits >> 23) - 129;
    if (exponent < -127) {
        exponent = -127;
    } else if (exponent > 127) {
        exponent = 127;
    }
    return exponent;
}

__device__ __forceinline__ float pow2_int(int exponent) {
    if (exponent >= -126) {
        return bits_to_float(static_cast<uint32_t>(exponent + 127) << 23);
    }

    return bits_to_float(1u << static_cast<uint32_t>(exponent + 149));
}

__device__ __forceinline__ uint8_t quantize_mxfp4_even(float magnitude, uint8_t sign_bit) {
    uint8_t code;

    if (magnitude <= 0.25f) {
        code = 0;
    } else if (magnitude < 0.75f) {
        code = 1;
    } else if (magnitude <= 1.25f) {
        code = 2;
    } else if (magnitude < 1.75f) {
        code = 3;
    } else if (magnitude <= 2.5f) {
        code = 4;
    } else if (magnitude < 3.5f) {
        code = 5;
    } else if (magnitude <= 5.0f) {
        code = 6;
    } else {
        code = 7;
    }

    return static_cast<uint8_t>(code | sign_bit);
}

template <bool IsBf16>
__global__ __launch_bounds__(256) void quant_mxfp4_even_kernel(
    const void* __restrict__ input,
    uint8_t* __restrict__ packed_output,
    uint8_t* __restrict__ scale_output,
    int64_t rows,
    int64_t cols) {
    const int64_t row = static_cast<int64_t>(blockIdx.x);
    if (row >= rows) {
        return;
    }

    constexpr int group_size = 32;
    constexpr int max_cols = 2048;
    constexpr int max_groups = max_cols / group_size;

    __shared__ float abs_values[max_cols];
    __shared__ float inv_scales[max_groups];

    const int tid = static_cast<int>(threadIdx.x);
    const int groups = static_cast<int>(cols / group_size);
    const int64_t row_offset = row * cols;

    for (int col = tid; col < cols; col += blockDim.x) {
        const float value = load_value<IsBf16>(input, row_offset + col);
        abs_values[col] = fabsf(value);
    }

    __syncthreads();

    for (int group = tid; group < groups; group += blockDim.x) {
        float amax = 0.0f;
        const int base = group * group_size;
#pragma unroll
        for (int i = 0; i < group_size; ++i) {
            amax = fmaxf(amax, abs_values[base + i]);
        }

        const int exponent = compute_exponent(amax);
        scale_output[row * static_cast<int64_t>(groups) + group] =
            static_cast<uint8_t>(exponent + 127);
        inv_scales[group] = pow2_int(-exponent);
    }

    __syncthreads();

    const int64_t packed_row_offset = row * (cols / 2);
    for (int packed_col = tid; packed_col < cols / 2; packed_col += blockDim.x) {
        const int col0 = packed_col * 2;
        const int col1 = col0 + 1;
        const float inv_scale = inv_scales[col0 / group_size];

        const int64_t idx0 = row_offset + col0;
        const int64_t idx1 = row_offset + col1;
        const float mag0 = fabsf(load_value<IsBf16>(input, idx0)) * inv_scale;
        const float mag1 = fabsf(load_value<IsBf16>(input, idx1)) * inv_scale;
        const uint8_t q0 = quantize_mxfp4_even(mag0, load_sign_bit(input, idx0));
        const uint8_t q1 = quantize_mxfp4_even(mag1, load_sign_bit(input, idx1));

        packed_output[packed_row_offset + packed_col] =
            static_cast<uint8_t>(q0 | static_cast<uint8_t>(q1 << 4));
    }
}

}  // namespace

// dtype: 0 = FP16, 1 = BF16. Pointers address distinct device buffers.
// Enqueue on stream and return a hipError_t integer; do not synchronize.
extern "C" int aiter_rs_quant_mxfp4_even(
    const void* input,
    void* packed_output,
    void* scale_output,
    int64_t rows,
    int64_t cols,
    int dtype,
    void* stream) {
    if (input == nullptr || packed_output == nullptr || scale_output == nullptr ||
        stream == nullptr || rows <= 0 || cols <= 0 || (cols % 32) != 0 ||
        dtype < 0 || dtype > 1) {
        return static_cast<int>(hipErrorInvalidValue);
    }

    const dim3 grid(static_cast<unsigned int>(rows));
    const dim3 block(256);
    hipLaunchKernelGGL(
        quant_mxfp4_even_kernel,
        grid,
        block,
        0,
        reinterpret_cast<hipStream_t>(stream),
        input,
        reinterpret_cast<uint8_t*>(packed_output),
        reinterpret_cast<uint8_t*>(scale_output),
        rows,
        cols,
        dtype);

    return static_cast<int>(hipGetLastError());
}
