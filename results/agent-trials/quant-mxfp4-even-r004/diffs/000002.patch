+    hipLaunchKernelGGL(quant_mxfp4_even_kernel, grid, block, 0, hip_stream,
+                       reinterpret_cast<const uint32_t*>(input),
+                       reinterpret_cast<uint8_t*>(packed_output),
+                       reinterpret_cast<uint8_t*>(scale_output),
