 #include <hip/hip_runtime.h>
 #include <stdint.h>
+
+namespace {
+
+__device__ __forceinline__ uint32_t f32_to_bits(float x) {
+    union {
+        float f;
+        uint32_t u;
+    } v;
+    v.f = x;
+    return v.u;
+}
+
+__device__ __forceinline__ float bits_to_f32(uint32_t x) {
+    union {
+        uint32_t u;
+        float f;
+    } v;
+    v.u = x;
+    return v.f;
+}
+
+__device__ __forceinline__ float half_bits_to_f32(uint16_t h) {
+    const uint32_t sign = (static_cast<uint32_t>(h & 0x8000u)) << 16;
+    const uint32_t exp = (h >> 10) & 0x1fu;
+    const uint32_t mant = h & 0x03ffu;
+
+    if (exp != 0) {
+        return bits_to_f32(sign | ((exp + 112u) << 23) | (mant << 13));
+    }
+    if (mant == 0) {
+        return bits_to_f32(sign);
+    }
+
+    float v = static_cast<float>(mant) * 0x1.0p-24f;
+    return sign ? -v : v;
+}
+
+__device__ __forceinline__ float bf16_bits_to_f32(uint16_t b) {
+    return bits_to_f32(static_cast<uint32_t>(b) << 16);
+}
+
+__device__ __forceinline__ uint8_t quantize_e2m1_even(float mag) {
+    if (!(mag > 0.25f)) return 0;
+    if (mag < 0.75f) return 1;
+    if (mag <= 1.25f) return 2;
+    if (mag < 1.75f) return 3;
+    if (mag <= 2.5f) return 4;
+    if (mag < 3.5f) return 5;
+    if (mag <= 5.0f) return 6;
+    return 7;
+}
+
+__global__ __launch_bounds__(32) void quant_mxfp4_even_kernel(
+    const uint16_t* __restrict__ input,
+    uint8_t* __restrict__ packed_output,
+    uint8_t* __restrict__ scale_output,
+    int64_t groups_per_row,
+    int dtype) {
+    const int lane = static_cast<int>(threadIdx.x);
+    const int64_t group_id = static_cast<int64_t>(blockIdx.x);
+    const int64_t elem_base = group_id * 32;
+    const uint16_t raw = input[elem_base + lane];
+
+    const float x = (dtype == 0) ? half_bits_to_f32(raw) : bf16_bits_to_f32(raw);
+    const bool neg = (raw & 0x8000u) != 0;
+    const float ax = bits_to_f32(f32_to_bits(x) & 0x7fffffffu);
+
+    __shared__ float reduce[32];
+    __shared__ uint8_t codes[32];
+    __shared__ uint8_t scale_byte_s;
+    __shared__ float inv_scale_s;
+
+    reduce[lane] = ax;
+    __syncthreads();
+
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        if (lane < offset) {
+            const float other = reduce[lane + offset];
+            reduce[lane] = (reduce[lane] > other) ? reduce[lane] : other;
+        }
+        __syncthreads();
+    }
+
+    if (lane == 0) {
+        const uint32_t r_bits = (f32_to_bits(reduce[0]) + 0x00200000u) & 0x7f800000u;
+        int exponent = -127;
+        if (r_bits != 0) {
+            exponent = static_cast<int>(r_bits >> 23) - 129;
+            exponent = exponent < -127 ? -127 : (exponent > 127 ? 127 : exponent);
+        }
+        scale_byte_s = static_cast<uint8_t>(exponent + 127);
+        inv_scale_s = ldexpf(1.0f, -exponent);
+        scale_output[group_id] = scale_byte_s;
+    }
+    __syncthreads();
+
+    const uint8_t mag_code = quantize_e2m1_even(ax * inv_scale_s);
+    codes[lane] = static_cast<uint8_t>(mag_code | (neg ? 0x8u : 0u));
+    __syncthreads();
+
+    if (lane < 16) {
+        const int64_t row = group_id / groups_per_row;
+        const int64_t group_col = group_id - row * groups_per_row;
+        const int64_t out_base = row * groups_per_row * 16 + group_col * 16;
+        packed_output[out_base + lane] =
+            static_cast<uint8_t>(codes[lane * 2] | (codes[lane * 2 + 1] << 4));
+    }
+}
+
+}  // namespace
 
 // dtype: 0 = FP16, 1 = BF16. Pointers address distinct device buffers.
